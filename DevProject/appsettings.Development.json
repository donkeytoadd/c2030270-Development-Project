{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "FileCleanup": {
    "Enabled": true,
    "RetentionHours": 24
  },
  "TmForumGitHub": {
    "Organization": "tmforum-apis",
    "CacheTtlHours": 24,
    "CacheDirectoryName": "tmforum-cache",
    "RequestTimeoutSeconds": 30
  }
}