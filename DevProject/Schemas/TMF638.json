{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TMF638 ServiceSpecification",
  "description": "TM Forum TMF638 Service Catalog Management API – ServiceSpecification (Giacom template)",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "id":              { "type": "string" },
    "href":            { "type": "string" },
    "name":            { "type": "string", "minLength": 1 },
    "description":     { "type": "string" },
    "version":         { "type": "string" },
    "isBundle":        { "type": "boolean" },
    "lifecycleStatus": { "type": "string" },
    "@type":           { "type": "string" },
    "@baseType":       { "type": "string" },
    "@schemaLocation": { "type": "string" },
    "relatedParty":    { "type": "array" },
    "serviceRelationship": { "type": "array" },
    "specCharacteristic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name":                             { "type": "string", "minLength": 1 },
          "description":                      { "type": "string" },
          "valueType":                        { "type": "string" },
          "minCardinality":                   { "type": "number" },
          "maxCardinality":                   { "type": "number" },
          "isUnique":                         { "type": "boolean" },
          "characteristicValueSpecification": { "type": "array" },
          "charSpecRelationship":             { "type": "array" },
          "@type":                            { "type": "string" },
          "@baseType":                        { "type": "string" },
          "@schemaLocation":                  { "type": "string" }
        }
      }
    },
    "featureSpecification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name":                    { "type": "string", "minLength": 1 },
          "description":             { "type": "string" },
          "isEnabled":               { "type": "boolean" },
          "isBundle":                { "type": "boolean" },
          "featureSpecRelationship": { "type": "array" },
          "@type":                   { "type": "string" }
        }
      }
    }
  }
}
