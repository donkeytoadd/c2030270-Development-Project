{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TMF641 ServiceOrder",
  "description": "TM Forum TMF641 Service Ordering Management API – ServiceOrder",
  "type": "object",
  "required": ["serviceOrderItem"],
  "additionalProperties": false,
  "properties": {
    "id":                  { "type": "string" },
    "href":                { "type": "string" },
    "cancellationDate":    { "type": "string", "format": "date-time" },
    "cancellationReason":  { "type": "string" },
    "category":            { "type": "string" },
    "completionDate":      { "type": "string", "format": "date-time" },
    "description":         { "type": "string" },
    "expectedCompletionDate": { "type": "string", "format": "date-time" },
    "externalId":          { "type": "string" },
    "notificationContact": { "type": "string" },
    "priority":            { "type": "string" },
    "requestedCompletionDate": { "type": "string", "format": "date-time" },
    "requestedStartDate":  { "type": "string", "format": "date-time" },
    "state":               { "type": "string" },
    "@type":               { "type": "string" },
    "@baseType":           { "type": "string" },
    "@schemaLocation":     { "type": "string" },
    "channel":             { "type": "array" },
    "jeopardyAlert":       { "type": "array" },
    "note":                { "type": "array" },
    "orderRelationship":   { "type": "array" },
    "relatedParty": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id":            { "type": "string" },
          "role":          { "type": "string" },
          "name":          { "type": "string" },
          "@referredType": { "type": "string" },
          "@type":         { "type": "string" }
        }
      }
    },
    "serviceOrderItem":    { "type": "array", "minItems": 1 }
  }
}
