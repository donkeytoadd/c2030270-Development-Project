{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TMF633 ServiceSpecification",
  "description": "TM Forum TMF633 Service Catalog Management API – ServiceSpecification",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "id":              { "type": "string" },
    "href":            { "type": "string" },
    "name":            { "type": "string", "minLength": 1 },
    "description":     { "type": "string" },
    "version":         { "type": "string" },
    "lastUpdate":      { "type": "string", "format": "date-time" },
    "lifecycleStatus": { "type": "string" },
    "isBundle":        { "type": "boolean" },
    "category": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id":            { "type": "string" },
          "name":          { "type": "string" },
          "@type":         { "type": "string" },
          "@referredType": { "type": "string" }
        }
      }
    },
    "@type":           { "type": "string" },
    "@baseType":       { "type": "string" },
    "@schemaLocation": { "type": "string" },
    "validFor": {
      "type": "object",
      "properties": {
        "startDateTime": { "type": "string", "format": "date-time" },
        "endDateTime":   { "type": "string", "format": "date-time" }
      }
    },
    "attachment":                { "type": "array" },
    "feature":                   { "type": "array" },
    "relatedParty":              { "type": "array" },
    "serviceSpecRelationship":   { "type": "array" },
    "targetServiceSchema":       { "type": "object" },
    "specCharacteristic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "id":             { "type": "string" },
          "name":           { "type": "string", "minLength": 1 },
          "description":    { "type": "string" },
          "extensible":     { "type": "boolean" },
          "isUnique":       { "type": "boolean" },
          "maxCardinality": { "type": "integer" },
          "minCardinality": { "type": "integer" },
          "regex":          { "type": "string" },
          "valueType":      { "type": "string" },
          "@type":          { "type": "string" },
          "@baseType":      { "type": "string" },
          "@schemaLocation":{ "type": "string" },
          "validFor": {
            "type": "object",
            "properties": {
              "startDateTime": { "type": "string", "format": "date-time" },
              "endDateTime":   { "type": "string", "format": "date-time" }
            }
          },
          "characteristicValueSpecification": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "isDefault":      { "type": "boolean" },
                "rangeInterval":  { "type": "string" },
                "regex":          { "type": "string" },
                "unitOfMeasure":  { "type": "string" },
                "value":          {},
                "valueFrom":      { "type": "integer" },
                "valueTo":        { "type": "integer" },
                "valueType":      { "type": "string" },
                "@type":          { "type": "string" },
                "@baseType":      { "type": "string" },
                "@schemaLocation":{ "type": "string" },
                "validFor": {
                  "type": "object",
                  "properties": {
                    "startDateTime": { "type": "string", "format": "date-time" },
                    "endDateTime":   { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "serviceSpecification":      { "type": "array" },
          "charSpecRelationship":      { "type": "array" }
        }
      }
    }
  }
}
