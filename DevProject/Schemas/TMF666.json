{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TMF666 BillingAccount",
  "description": "TM Forum TMF666 Account Management API – BillingAccount",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "id":                  { "type": "string" },
    "href":                { "type": "string" },
    "accountType":         { "type": "string" },
    "description":         { "type": "string" },
    "lastModified":        { "type": "string", "format": "date-time" },
    "name":                { "type": "string", "minLength": 1 },
    "paymentStatus":       { "type": "string" },
    "ratingType":          { "type": "string" },
    "state":               { "type": "string" },
    "@type":               { "type": "string" },
    "@baseType":           { "type": "string" },
    "@schemaLocation":     { "type": "string" },
    "accountBalance":      { "type": "array" },
    "accountRelationship": { "type": "array" },
    "billStructure":       { "type": "object" },
    "contact":             { "type": "array" },
    "creditLimit":         { "type": "object" },
    "defaultPaymentMethod":{ "type": "object" },
    "financialAccount":    { "type": "object" },
    "paymentPlan":         { "type": "array" },
    "relatedParty":        { "type": "array" },
    "taxExemption":        { "type": "array" },
    "validFor": {
      "type": "object",
      "properties": {
        "startDateTime": { "type": "string", "format": "date-time" },
        "endDateTime":   { "type": "string", "format": "date-time" }
      }
    }
  }
}
