{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TMF637 Product",
  "description": "TM Forum TMF637 Product Inventory Management API – Product",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "id":              { "type": "string" },
    "href":            { "type": "string" },
    "name":            { "type": "string", "minLength": 1 },
    "description":     { "type": "string" },
    "isBundle":        { "type": "boolean" },
    "isCustomerVisible": { "type": "boolean" },
    "productSerialNumber": { "type": "string" },
    "startDate":       { "type": "string", "format": "date-time" },
    "terminationDate": { "type": "string", "format": "date-time" },
    "status":          { "type": "string" },
    "@type":           { "type": "string" },
    "@baseType":       { "type": "string" },
    "@schemaLocation": { "type": "string" },
    "billingAccount":  { "type": "array" },
    "productCharacteristic": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name":           { "type": "string", "minLength": 1 },
          "value":          {},
          "valueType":      { "type": "string" },
          "@type":          { "type": "string" },
          "@baseType":      { "type": "string" },
          "@schemaLocation":{ "type": "string" }
        }
      }
    },
    "productOffering":    { "type": "object" },
    "productRelationship":{ "type": "array" },
    "productSpecification":{ "type": "object" },
    "productTerm":        { "type": "array" },
    "realizingResource":  { "type": "array" },
    "realizingService":   { "type": "array" },
    "relatedParty":       { "type": "array" },
    "validFor": {
      "type": "object",
      "properties": {
        "startDateTime": { "type": "string", "format": "date-time" },
        "endDateTime":   { "type": "string", "format": "date-time" }
      }
    }
  }
}
